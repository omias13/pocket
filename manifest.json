{
  "name": "Omias Pocket",
  "short_name": "Pocket",
  "description": "The Omias check-in, on a phone — files what you enter even when the PC is off.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "shortcuts": [
    { "name": "Log", "short_name": "Log", "url": "./index.html?view=home&log=1", "icons": [{ "src": "icon.png", "sizes": "512x512", "type": "image/png" }] },
    { "name": "Add expense", "short_name": "Expense", "url": "./index.html?view=spend", "icons": [{ "src": "icon.png", "sizes": "512x512", "type": "image/png" }] },
    { "name": "Add task", "short_name": "Task", "url": "./index.html?view=checkin", "icons": [{ "src": "icon.png", "sizes": "512x512", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "slip", "accept": ["image/*"] }] }
  },
  "background_color": "#1c1917",
  "theme_color": "#1c1917",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
